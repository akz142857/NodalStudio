{
  "name": "nodalstudio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @nodalstudio/frontend build",
    "build:web": "pnpm --filter @nodalstudio/frontend build",
    "dev": "pnpm --filter @nodalstudio/frontend dev",
    "dev:desktop": "pnpm --filter @nodalstudio/desktop tauri dev",
    "lint": "pnpm --filter @nodalstudio/frontend lint",
    "release:macos": "./Scripts/build_macos_release.sh",
    "release:macos:appstore": "./Scripts/build_macos_appstore.sh",
    "release:windows:test": "pwsh -NoProfile -File Scripts/build_windows_test.ps1",
    "test": "pnpm --filter @nodalstudio/frontend test",
    "typecheck": "pnpm --filter @nodalstudio/frontend typecheck",
    "tauri": "pnpm --filter @nodalstudio/desktop tauri"
  }
}
