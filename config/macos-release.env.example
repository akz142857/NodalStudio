# Copy this file to config/macos-release.env and fill in the values.
# The real config file is ignored by Git because it may contain secrets.

# Use "auto" when only one Developer ID Application identity is available.
# Otherwise provide the exact identity shown by:
# security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=auto

# App Store Connect API key values used for Apple notarization.
APPLE_API_ISSUER=
# May be left empty when APPLE_API_KEY_PATH is named AuthKey_KEYID.p8.
APPLE_API_KEY=
APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8

# Optional: import a Developer ID Application certificate from a .p12 file into
# a temporary build keychain. Leave both values empty when the certificate and
# private key are already installed in the login keychain.
APPLE_CERTIFICATE_PATH=
APPLE_CERTIFICATE_PASSWORD=

# Release behavior.
BUILD_TARGET=universal-apple-darwin
BUNDLE_FORMAT=dmg
REQUIRE_CLEAN_GIT=true
INSTALL_DEPENDENCIES=false
