# Copy this file to config/macos-appstore.env and fill in the values.
# The real config is ignored by Git because it may contain secrets.

APP_BUNDLE_ID=com.claycosmos.nodalstudio
APPLE_TEAM_ID=V49J3X8K3S
PROVISIONING_PROFILE=/absolute/path/to/Nodal_Studio_Mac_App_Store.provisionprofile

# Use auto to select the application signing certificate contained in the
# provisioning profile and the single installed Mac installer certificate.
APP_DISTRIBUTION_IDENTITY=auto
INSTALLER_DISTRIBUTION_IDENTITY=auto

# Optional .p12 imports. Leave empty when both certificates and their private
# keys are already installed in the login keychain.
APP_DISTRIBUTION_CERTIFICATE_PATH=
APP_DISTRIBUTION_CERTIFICATE_PASSWORD=
INSTALLER_DISTRIBUTION_CERTIFICATE_PATH=
INSTALLER_DISTRIBUTION_CERTIFICATE_PASSWORD=

# CFBundleVersion. Increase this value for every App Store Connect upload.
APP_BUILD_NUMBER=1

# Optional App Store Connect API credentials. They are required only with
# --upload; omit them when uploading the generated .pkg with Transporter.
APPLE_API_ISSUER=
# May be empty when APPLE_API_KEY_PATH is named AuthKey_KEYID.p8.
APPLE_API_KEY_ID=
APPLE_API_KEY_PATH=

# Build behavior.
BUILD_TARGET=universal-apple-darwin
OUTPUT_DIRECTORY=dist/app-store
REQUIRE_CLEAN_GIT=true
INSTALL_DEPENDENCIES=false
