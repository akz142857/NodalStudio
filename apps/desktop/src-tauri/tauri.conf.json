{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodal Studio",
  "version": "0.2.3",
  "identifier": "com.claycosmos.nodalstudio",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nodal Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QTQ2RTZDQjk5NkI4QUIKUldTcnVKYTViRzZrRkl2RTBabFdvNVVtU0E4K1I4bmpBUDJqeVZhcTd4S3paMzlzcFJDVXJKd1cK",
      "endpoints": [
        "https://github.com/akz142857/NodalStudio/releases/latest/download/latest.json"
      ]
    }
  }
}
