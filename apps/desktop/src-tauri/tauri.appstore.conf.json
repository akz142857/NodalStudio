{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodal Studio",
  "identifier": "com.claycosmos.nodalstudio",
  "bundle": {
    "category": "DeveloperTool",
    "macOS": {
      "bundleVersion": "2",
      "entitlements": "./Entitlements.appstore.plist",
      "infoPlist": "./Info.appstore.plist",
      "files": {
        "embedded.provisionprofile": "./.appstore/embedded.provisionprofile",
        "Resources/PrivacyInfo.xcprivacy": "./PrivacyInfo.xcprivacy",
        "Resources/RingPrivacy.bundle": "./privacy/RingPrivacy.bundle"
      },
      "minimumSystemVersion": "13.0"
    }
  },
  "build": {
    "features": [
      "mac-app-store"
    ]
  },
  "plugins": {
    "updater": null
  }
}
